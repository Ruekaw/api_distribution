# Required secrets/configuration
UPSTREAM_URL=https://your-dify-host.example/v1/chat/completions
UPSTREAM_API_KEY=replace-with-dify-endpoint-key
GROUP_API_KEY=replace-with-shared-client-key
IP_HMAC_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional configuration
MODEL_NAME=claude-opus-4.6
PER_IP_RPM_LIMIT=10
HOURLY_UNIQUE_IP_LIMIT=10
GLOBAL_REQUEST_LIMIT=150
DISABLE_AT=
MAX_CONCURRENCY=3
LEASE_TTL_SECONDS=900
PORT=3000
HOST=0.0.0.0
