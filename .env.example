# Required secrets/configuration
UPSTREAM_URL=https://your-dify-host.example/v1/chat/completions
UPSTREAM_API_KEY=replace-with-dify-endpoint-key
GROUP_API_KEY=replace-with-shared-client-key
IP_HMAC_SECRET=replace-with-a-long-random-secret

# Aurora PostgreSQL (injected automatically by Vercel Aurora integration)
PGHOST=your-aurora-cluster.cluster-xxxxxxxx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/your-aurora-role

# Optional configuration
MODEL_NAME=claude-opus-4.6
PER_IP_RPM_LIMIT=10
HOURLY_UNIQUE_IP_LIMIT=10
GLOBAL_REQUEST_LIMIT=150
DISABLE_AT=
MAX_CONCURRENCY=3
LEASE_TTL_SECONDS=360
